# PodLever — Environment Variable Reference
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# All secrets must be set via Replit Secrets in the workspace.

# ─── Database ─────────────────────────────────────────────────────────────────
# Auto-provisioned by Replit PostgreSQL. Available in Replit workspace automatically.
# For local dev: set to your local PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/podlever

# ─── Session / Security ───────────────────────────────────────────────────────
# Used by iron-session to AES-256-GCM encrypt the session cookie.
# Must be >= 32 characters. Set via Replit Secrets (already provisioned).
# Generate: openssl rand -base64 32
SESSION_SECRET=<set-via-replit-secrets-minimum-32-chars>

# ─── Replit Platform (auto-injected in Replit workspace) ─────────────────────
# These are auto-injected by Replit — do NOT set them manually in the workspace.
# Set them here only for local development outside Replit.

# Replit Repl ID — used as the OIDC client_id for Replit Auth PKCE flow.
# Auto-injected by Replit. Find yours at: replit.com/account
REPL_ID=<your-repl-id>

# Replit dev domain — used to construct the OIDC callback URL.
# Format: <repl-slug>.<username>.repl.co
REPLIT_DEV_DOMAIN=<your-repl-slug>.<username>.repl.co

# Replit workspace user ID (available in dev workspace only, not in autoscale).
REPLIT_USERID=19531679
REPLIT_USER=RussellNomer

# ─── Auth Configuration ───────────────────────────────────────────────────────
# The Replit numeric user ID that gets role="owner" in PodLever.
# Defaults to REPLIT_USERID if not explicitly set.
# Required in autoscale deployments (REPLIT_USERID is not injected there).
# Set via Replit Secrets with the key: OWNER_REPLIT_USER_ID
OWNER_REPLIT_USER_ID=19531679

# ─── Phase 1B (not yet required) ─────────────────────────────────────────────
# Add as Phase 1B infrastructure is provisioned:
# OPENAI_API_KEY=              (AI asset generation — use Replit AI integration instead)
# DEEPGRAM_API_KEY=            (audio transcription — or use Replit AI proxy)
# STORAGE_BUCKET=              (Replit object storage — see object-storage skill)

# ─── Invite emails (Google Workspace) ─────────────────────────────────────────
# When configured, beta invites are emailed automatically from INVITE_FROM_EMAIL.
# When absent, the owner sends invites manually via the "Send invite email"
# button on /admin/waitlist (mailto flow). Never hard-fails.
#
# PREFERRED — service account (no user password stored; gmail.send scope only):
#   1. console.cloud.google.com → enable Gmail API → create service account →
#      Keys → Add key (JSON)
#   2. admin.google.com → Security → API controls → Domain-wide delegation →
#      Add the service account's numeric Client ID with scope:
#      https://www.googleapis.com/auth/gmail.send
#   3. Set the two secrets below (paste the ENTIRE JSON key as one line):
GMAIL_SERVICE_ACCOUNT_KEY=<full-service-account-json>
GMAIL_IMPERSONATE_USER=russell@russellnomer.com
#
# FALLBACK — SMTP App Password (requires 2FA; myaccount.google.com/apppasswords):
GMAIL_SMTP_USER=russell@russellnomer.com
GMAIL_SMTP_APP_PASSWORD=<16-char-google-app-password>
#
# From address (must be a "Send mail as" alias of the user above):
INVITE_FROM_EMAIL=invites@podlever.com

# ─── Stripe webhook (payment fulfillment) ─────────────────────────────────────
# Signing secret for the /api/billing/webhook endpoint. Printed once by
# `pnpm stripe:setup` (or copy from dashboard.stripe.com → Developers →
# Webhooks). Without it, successful payments will NOT upgrade user plans.
STRIPE_WEBHOOK_SECRET=whsec_...
