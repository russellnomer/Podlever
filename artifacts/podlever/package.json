{
  "name": "@workspace/podlever",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000} -H 0.0.0.0",
    "build": "next build",
    "build:prod": "node scripts/migrate-prod.mjs && next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:push-force": "drizzle-kit push --force --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "verify-fsm": "tsx scripts/verify-fsm.ts",
    "verify-auth": "tsx scripts/verify-auth.ts",
    "verify-export-rate-limit": "tsx scripts/verify-export-rate-limit.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@types/nodemailer": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "iron-session": "^8.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "catalog:",
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "openid-client": "^6.8.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "^0.0.1",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/jszip": "^3.4.1",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/runner": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "^0.8.3",
    "postcss": "^8.5.23",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
